       dropdown.style.display \x3d \x27block\x27;\\n          \x7d;\\n\\n          input.addEventListener(\x27input\x27, filterItems);\\n          input.addEventListener(\x27focus\x27, filterItems);\\n          input.addEventListener(\x27blur\x27, () \x3d\x3e \x7b\\n            setTimeout(() \x3d\x3e dropdown.style.display \x3d \x27none\x27, 150);\\n          \x7d);\\n        \x7d);\\n      \x7d\\n\\n      function addRow() \x7b\\n        var container \x3d document.getElementById(\x27entries-container\x27);\\n        var row \x3d document.createElement(\x27div\x27);\\n        row.className \x3d \x27form-group entry-row\x27;\\n        row.style.position \x3d \x27relative\x27;\\n        row.innerHTML \x3d `\\n          \x3cdiv style\x3d\\\x22flex:1; position:relative;\\\x22\x3e\\n            \x3cinput type\x3d\\\x22text\\\x22 class\x3d\\\x22playerName autocomplete-input\\\x22 placeholder\x3d\\\x22Player Name...\\\x22 autocomplete\x3d\\\x22off\\\x22\x3e\\n            \x3cdiv class\x3d\\\x22custom-dropdown\\\x22\x3e\x3c\\\/div\x3e\\n          \x3c\\\/div\x3e\\n          \x3cinput type\x3d\\\x22number\\\x22 class\x3d\\\x22amount\\\x22 placeholder\x3d\\\x22Amount...\\\x22 style\x3d\\\x22flex: 1;\\\x22\x3e\\n          \x3cbutton class\x3d\\\x22btn btn-remove\\\x22 onclick\x3d\\\x22removeRow(this)\\\x22\x3eX\x3c\\\/button\x3e\\n        `;\\n        container.appendChild(row);\\n        bindAutocomplete(); \/\/ Bind events to the newly added row\\n        row.querySelector(\x27.playerName\x27).focus();\\n      \x7d\\n\\n      function removeRow(btn) \x7b\\n        var row \x3d btn.parentElement;\\n        if (document.querySelectorAll(\x27.entry-row\x27).length \x3e 1) \x7b\\n          row.remove();\\n        \x7d\\n      \x7d\\n\\n      function submitEntries() \x7b\\n        var rows \x3d document.querySelectorAll(\x27.entry-row\x27);\\n        var entries \x3d \x5b\x5d;\\n        var statusDiv \x3d document.getElementById(\x27status\x27);\\n        var submitBtn \x3d document.getElementById(\x27submitBtn\x27);\\n\\n        \\n        rows.forEach(function(row) \x7b\\n          var name \x3d row.querySelector(\x27.playerName\x27).value;\\n          var amount \x3d row.querySelector(\x27.amount\x27).value;\\n          if (name \x26\x26 amount) \x7b\\n            entries.push(\x7bname: name, amount: amount\x7d);\\n          \x7d\\n        \x7d);\\n\\n        if (entries.length \x3d\x3d\x3d 0) \x7b\\n          statusDiv.innerHTML \x3d \\\x22\x3cspan class\x3d\x27error-msg\x27\x3ePlease enter at least one valid name and amount.\x3c\\\/span\x3e\\\x22;\\n          return;\\n        \x7d\\n\\n        submitBtn.disabled \x3d true;\\n        submitBtn.innerHTML \x3d \\\x22⏳ Processing...\\\x22;\\n        statusDiv.innerHTML \x3d \\\x22\x3cspan style\x3d\x27color:var(--text-muted);\x27\x3eProcessing \\\x22 + entries.length + \\\x22 entries...\x3c\\\/span\x3e\\\x22;\\n        \\n        var completed \x3d 0;\\n        var resultsHTML \x3d \\\x22\x3cdiv class\x3d\x27success-list\x27\x3e\x3cstrong\x3eSuccess!\x3c\\\/strong\x3e\x3cbr\x3e\\\x22;\\n\\n        \\n        entries.forEach(function(entry) \x7b\\n          google.script.run.withSuccessHandler(function(response) \x7b\\n            completed++;\\n            \\n            \\n            if (response \x26\x26 response.success) \x7b\\n               resultsHTML +\x3d `✅ \x3cb\x3e$\x7bresponse.name\x7d\x3c\\\/b\x3e: +$\x7bresponse.amount\x7d (New Total: $\x7bresponse.newTotal\x7d)\x3cbr\x3e`;\\n            \x7d else if (response \x26\x26 response.message) \x7b\\n               resultsHTML +\x3d `❌ $\x7bresponse.message\x7d\x3cbr\x3e`;\\n            \x7d else \x7b\\n               \/\/ Fallback just in case\\n               resultsHTML +\x3d `✅ \x3cb\x3e$\x7bentry.name\x7d\x3c\\\/b\x3e: +$\x7bentry.amount\x7d added.\x3cbr\x3e`;\\n            \x7d\\n\\n            \/\/ Check if all entries have finished processing\\n            if (completed \x3d\x3d\x3d entries.length) \x7b\\n              resultsHTML +\x3d \\\x22\x3c\\\/div\x3e\\\x22;\\n              statusDiv.innerHTML \x3d resultsHTML;\\n              resetForm();\\n              loadActivityLog();\\n              submitBtn.disabled \x3d false;\\n              submitBtn.innerHTML \x3d \\\x22Submit All Entries\\\x22;\\n            \x7d\\n          \x7d).addBearTrapEntry(entry.name, entry.amount);\\n        \x7d);\\n      \x7d\\n\\n      function resetForm() \x7b\\n        var container \x3d document.getElementById(\x27entries-container\x27);\\n        container.innerHTML \x3d `\\n          \x3cdiv class\x3d\\\x22form-group entry-row\\\x22 style\x3d\\\x22position:relative;\\\x22\x3e\\n            \x3cdiv style\x3d\\\x22flex:1; position:relative;\\\x22\x3e\\n              \x3cinput type\x3d\\\x22text\\\x22 class\x3d\\\x22playerName autocomplete-input\\\x22 placeholder\x3d\\\x22Player Name...\\\x22 autocomplete\x3d\\\x22off\\\x22\x3e\\n              \x3cdiv class\x3d\\\x22custom-dropdown\\\x22\x3e\x3c\\\/div\x3e\\n            \x3c\\\/div\x3e\\n            \x3cinput type\x3d\\\x22number\\\x22 class\x3d\\\x22amount\\\x22 placeholder\x3d\\\x22Amount...\\\x22 style\x3d\\\x22flex: 1;\\\x22\x3e\\n            \x3cbutton class\x3d\\\x22btn btn-remove\\\x22 onclick\x3d\\\x22removeRow(this)\\\x22\x3eX\x3c\\\/button\x3e\\n          \x3c\\\/div\x3e\\n        `;\\n        bindAutocomplete(); \\n        document.querySelector(\x27.playerName\x27).focus();\\n      \x7d\\n    \x3c\\\/script\x3e\\n  \x3c\\\/body\x3e\\n\x3c\\\/html\x3e\\n\x22,\x22ncc\x22:\x22\x7b\\\x22awhs\\\x22:true\x7d\x22\x7d", "", undefined, true , false  , "false", "https:\/\/n-rglcudahicuyfhr6sxvt5cymgqblwhnem4krpkq-0lu-script.googleusercontent.com", "https:\/\/drive.google.com\/abuse?id\x3dAKkXjoyhQyszsCV7ZjLyvaQthgerM63LUiT1W3vCnlrXDIjtgY5ayED0RPWCINIWOMEAEUH0yqorPzmgCvqzruRU1ks2O6v1czVPb-WK%3A0\x26docurl\x3dhttps%3A%2F%2Fscript.google.com%2Fmacros%2Fs%2FAKfycbxPlNaLMDn4LX7ZpbOc8O2VzQr055fnynJnyDinedM7stFe_PMdZWkpf8BMTrysH4U%2Fexec%3Faction%3Dget